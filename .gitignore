# Python and notebooks
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Local environments and editor state
.venv/
venv/
.idea/
.vscode/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Large research artifacts must live outside Git
data/
datasets/
checkpoints/
weights/
outputs/
results/
logs/
runs/
wandb/
.cache/
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5

# Third-party source is fetched from immutable revisions and never vendored
third_party/*/
!third_party/README.md
!third_party/LOCK.json

# OS-generated files
.DS_Store
Thumbs.db
